{
  "name": "miot-bridge-api",
  "version": "0.18.1",
  "private": true,
  "description": "Bridge between Loxone/other controllers and Xiaomi devices via miot protocol",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && swc src --out-dir dist -s --strip-leading-paths",
    "cleanup:all": "pnpm run cleanup:artifacts && pnpm run cleanup:modules",
    "cleanup:artifacts": "rm -rf coverage dist",
    "cleanup:modules": "rm -rf node_modules",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "start": "nodemon src/index.ts",
    "start:prod": "node --import @swc-node/register/esm-register --import /home/app/dist/otel/instrument.js dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@opentelemetry/api": "catalog:otel",
    "@opentelemetry/instrumentation-mongoose": "catalog:otel",
    "@opentelemetry/winston-transport": "catalog:otel",
    "@radoslavirha/config-typescript": "catalog:",
    "@radoslavirha/miot-device": "workspace:*",
    "@radoslavirha/otel": "workspace:*",
    "@radoslavirha/tsed-common": "catalog:",
    "@radoslavirha/tsed-configuration": "catalog:",
    "@radoslavirha/tsed-logger": "catalog:",
    "@radoslavirha/tsed-mongoose": "catalog:",
    "@radoslavirha/tsed-platform": "catalog:",
    "@radoslavirha/tsed-swagger": "catalog:",
    "@radoslavirha/utils": "catalog:",
    "@swc-node/register": "catalog:swc",
    "@swc/cli": "catalog:swc",
    "@swc/helpers": "catalog:swc",
    "@tsed/ajv": "catalog:tsed",
    "@tsed/core": "catalog:tsed",
    "@tsed/di": "catalog:tsed",
    "@tsed/engines": "catalog:tsed",
    "@tsed/exceptions": "catalog:tsed",
    "@tsed/json-mapper": "catalog:tsed",
    "@tsed/mongoose": "catalog:tsed",
    "@tsed/openspec": "catalog:tsed",
    "@tsed/platform-cache": "catalog:tsed",
    "@tsed/platform-exceptions": "catalog:tsed",
    "@tsed/platform-express": "catalog:tsed",
    "@tsed/platform-http": "catalog:tsed",
    "@tsed/platform-log-request": "catalog:tsed",
    "@tsed/platform-middlewares": "catalog:tsed",
    "@tsed/platform-params": "catalog:tsed",
    "@tsed/platform-response-filter": "catalog:tsed",
    "@tsed/platform-views": "catalog:tsed",
    "@tsed/schema": "catalog:tsed",
    "@tsed/swagger": "catalog:tsed",
    "ajv": "catalog:tsed",
    "axios": "catalog:",
    "body-parser": "catalog:express",
    "compression": "catalog:express",
    "cookie-parser": "catalog:express",
    "cors": "catalog:express",
    "cross-env": "catalog:",
    "dotenv": "catalog:",
    "express": "catalog:express",
    "method-override": "catalog:express",
    "mongoose": "^9.7.1",
    "mqtt": "^5.15.1",
    "typescript": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@radoslavirha/config-eslint": "catalog:",
    "@radoslavirha/config-vitest": "catalog:",
    "@swc/core": "catalog:swc",
    "@types/compression": "catalog:express",
    "@types/cookie-parser": "catalog:express",
    "@types/cors": "catalog:express",
    "@types/express": "catalog:express",
    "@types/method-override": "catalog:express",
    "@types/multer": "catalog:express",
    "@types/node": "catalog:",
    "@types/supertest": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "axios-mock-adapter": "^2.1.0",
    "eslint": "catalog:",
    "nodemon": "catalog:",
    "supertest": "catalog:",
    "tslib": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">= 24",
    "pnpm": ">= 11.8"
  },
  "tsed": {
    "convention": "conv_default",
    "architecture": "arc_default",
    "packageManager": "pnpm",
    "runtime": "node"
  }
}