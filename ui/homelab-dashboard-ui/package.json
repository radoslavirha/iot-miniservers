{
    "name": "homelab-dashboard-ui",
    "version": "0.2.0",
    "private": true,
    "description": "Dashboard UI for homelab services, driven by Unifi DNS records.",
    "type": "module",
    "scripts": {
        "build": "tsc --noEmit && vite build",
        "cleanup:all": "pnpm run cleanup:artifacts && pnpm run cleanup:modules",
        "cleanup:artifacts": "rm -rf coverage dist",
        "cleanup:modules": "rm -rf node_modules",
        "dev": "vite",
        "lint": "eslint .",
        "lint:fix": "eslint --fix .",
        "preview": "vite preview",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@radoslavirha/ui-kit": "workspace:*",
        "react": "catalog:react",
        "react-dom": "catalog:react"
    },
    "devDependencies": {
        "@radoslavirha/config-eslint": "catalog:",
        "@radoslavirha/config-typescript": "catalog:",
        "@testing-library/jest-dom": "catalog:react",
        "@testing-library/react": "catalog:react",
        "@testing-library/user-event": "catalog:react",
        "@types/node": "catalog:",
        "@types/react": "catalog:react",
        "@types/react-dom": "catalog:react",
        "@vitejs/plugin-react": "catalog:react",
        "@vitest/coverage-v8": "catalog:",
        "eslint": "catalog:",
        "jsdom": "catalog:react",
        "typescript": "catalog:",
        "typescript-eslint": "catalog:",
        "vite": "catalog:react",
        "vitest": "catalog:"
    },
    "engines": {
        "node": ">= 24",
        "pnpm": ">= 11"
    }
}
