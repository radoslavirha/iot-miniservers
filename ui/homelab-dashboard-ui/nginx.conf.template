server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # k8s liveness / readiness probe. Exact match, shared with every other UI
    # image — see packages/nginx-runtime.
    include /etc/nginx/snippets/healthz.conf;

    # SPA routing
    location / {
        try_files $uri $uri/ /index.html;
    }

    # No-cache on config.json so a ConfigMap update takes effect on next page load.
    location = /config.json {
        add_header Cache-Control "no-store, no-cache, must-revalidate";
        try_files $uri =404;
    }

    # Proxy all Unifi Network-app requests to the controller.
    # ${UNIFI_HOST} and ${SECRET_UNIFI_API_KEY} are substituted by envsubst at
    # container start; 10-require-unifi-env.sh has already refused to boot if
    # either is empty.
    location /proxy/network/ {
        proxy_pass         ${UNIFI_HOST}/proxy/network/;
        proxy_http_version 1.1;
        proxy_set_header   Host              $proxy_host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        # The credential is deliberately server-side: a browser is an untrusted
        # execution environment, so the key lives at the first server-side hop
        # instead of in config.json. proxy_set_header also *replaces* any
        # client-supplied X-Api-Key, so a visitor cannot inject their own.
        # Note: `nginx -T` prints this rendered config, key included.
        proxy_set_header   X-Api-Key         "${SECRET_UNIFI_API_KEY}";
        proxy_ssl_verify   off;
    }
}
