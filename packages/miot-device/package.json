{
    "name": "@radoslavirha/miot-device",
    "version": "0.3.0",
    "description": "Stateful MIoT device client with per-device stamp management",
    "private": true,
    "type": "module",
    "exports": {
        "import": {
            "types": "./dist/esm/index.d.mts",
            "import": "./dist/esm/index.mjs"
        },
        "require": {
            "types": "./dist/cjs/index.d.cts",
            "require": "./dist/cjs/index.cjs"
        }
    },
    "main": "./dist/cjs/index.cjs",
    "module": "./dist/esm/index.mjs",
    "types": "./dist/esm/index.d.mts",
    "files": [
        "dist",
        "package.json",
        "README.md"
    ],
    "scripts": {
        "build": "tsc --noEmit && tsdown",
        "cleanup:all": "pnpm run cleanup:artifacts && pnpm run cleanup:modules",
        "cleanup:artifacts": "rm -rf coverage dist",
        "cleanup:modules": "rm -rf node_modules",
        "lint": "eslint .",
        "lint:fix": "eslint --fix .",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@radoslavirha/config-typescript": "catalog:",
        "@radoslavirha/utils": "catalog:",
        "typescript": "catalog:"
    },
    "devDependencies": {
        "@radoslavirha/config-eslint": "catalog:",
        "@radoslavirha/config-tsdown": "0.1.5",
        "@radoslavirha/config-vitest": "catalog:",
        "@types/node": "catalog:",
        "@vitest/coverage-v8": "catalog:",
        "eslint": "catalog:",
        "tsdown": "0.21.4",
        "typescript-eslint": "catalog:",
        "vitest": "catalog:"
    }
}