{
    "name": "@radoslavirha/resilience",
    "version": "0.1.0",
    "description": "Transport-agnostic resilience (timeout, retry, circuit breaker) with AbortSignal support, backed by cockatiel",
    "private": true,
    "type": "module",
    "exports": {
        "import": {
            "types": "./dist/esm/index.d.mts",
            "import": "./dist/esm/index.mjs"
        },
        "require": {
            "types": "./dist/cjs/index.d.cts",
            "require": "./dist/cjs/index.cjs"
        }
    },
    "main": "./dist/cjs/index.cjs",
    "module": "./dist/esm/index.mjs",
    "types": "./dist/esm/index.d.mts",
    "files": [
        "dist",
        "package.json",
        "README.md"
    ],
    "scripts": {
        "build": "tsc --noEmit && tsdown",
        "cleanup:all": "pnpm run cleanup:artifacts && pnpm run cleanup:modules",
        "cleanup:artifacts": "rm -rf coverage dist",
        "cleanup:modules": "rm -rf node_modules",
        "lint": "eslint .",
        "lint:fix": "eslint --fix .",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@radoslavirha/config-typescript": "catalog:",
        "cockatiel": "catalog:",
        "typescript": "catalog:",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@radoslavirha/config-eslint": "catalog:",
        "@radoslavirha/config-tsdown": "catalog:",
        "@radoslavirha/config-vitest": "catalog:",
        "@tsed/testcontainers-mongo": "catalog:tsed",
        "@types/node": "catalog:",
        "@vitest/coverage-v8": "catalog:",
        "eslint": "catalog:",
        "mongoose": "catalog:",
        "tsdown": "catalog:",
        "typescript-eslint": "catalog:",
        "vitest": "catalog:"
    }
}
