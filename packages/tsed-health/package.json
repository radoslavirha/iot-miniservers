{
    "name": "@radoslavirha/tsed-health",
    "version": "0.2.1",
    "description": "Ts.ED health endpoints: /health, /health/live and /health/ready backed by a DI-registered check registry, plus a correct graceful-shutdown drain",
    "private": true,
    "type": "module",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/esm/index.d.mts",
                "import": "./dist/esm/index.mjs"
            },
            "require": {
                "types": "./dist/cjs/index.d.cts",
                "require": "./dist/cjs/index.cjs"
            }
        },
        "./mongoose": {
            "import": {
                "types": "./dist/esm/mongoose.d.mts",
                "import": "./dist/esm/mongoose.mjs"
            },
            "require": {
                "types": "./dist/cjs/mongoose.d.cts",
                "require": "./dist/cjs/mongoose.cjs"
            }
        }
    },
    "main": "./dist/cjs/index.cjs",
    "module": "./dist/esm/index.mjs",
    "types": "./dist/esm/index.d.mts",
    "files": [
        "dist",
        "package.json",
        "README.md"
    ],
    "scripts": {
        "build": "tsc --noEmit && tsdown",
        "cleanup:all": "pnpm run cleanup:artifacts && pnpm run cleanup:modules",
        "cleanup:artifacts": "rm -rf coverage dist",
        "cleanup:modules": "rm -rf node_modules",
        "lint": "eslint .",
        "lint:fix": "eslint --fix .",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@radoslavirha/config-typescript": "catalog:",
        "@radoslavirha/health": "workspace:*",
        "typescript": "catalog:"
    },
    "devDependencies": {
        "@radoslavirha/config-eslint": "catalog:",
        "@radoslavirha/config-tsdown": "catalog:",
        "@radoslavirha/config-vitest": "catalog:",
        "@swc/helpers": "catalog:swc",
        "@tsed/core": "catalog:tsed",
        "@tsed/di": "catalog:tsed",
        "@tsed/mongoose": "catalog:tsed",
        "@tsed/platform-express": "catalog:tsed",
        "@tsed/platform-http": "catalog:tsed",
        "@tsed/platform-params": "catalog:tsed",
        "@tsed/schema": "catalog:tsed",
        "@tsed/testcontainers-mongo": "catalog:tsed",
        "@types/node": "catalog:",
        "@types/supertest": "catalog:",
        "@vitest/coverage-v8": "catalog:",
        "eslint": "catalog:",
        "mongoose": "catalog:",
        "supertest": "catalog:",
        "tsdown": "catalog:",
        "tslib": "catalog:",
        "typescript-eslint": "catalog:",
        "vitest": "catalog:"
    },
    "peerDependencies": {
        "@tsed/core": "catalog:tsed",
        "@tsed/di": "catalog:tsed",
        "@tsed/mongoose": "catalog:tsed",
        "@tsed/platform-http": "catalog:tsed",
        "@tsed/platform-params": "catalog:tsed",
        "@tsed/schema": "catalog:tsed",
        "mongoose": "catalog:"
    },
    "peerDependenciesMeta": {
        "@tsed/mongoose": {
            "optional": true
        },
        "mongoose": {
            "optional": true
        }
    }
}
