{
    "name": "@radoslavirha/nginx-runtime",
    "version": "0.2.1",
    "private": true,
    "description": "Shared nginx probe endpoint and runtime-config guard for the SPA images",
    "type": "module",
    "files": [
        "conf.d",
        "docker-entrypoint.d",
        "package.json",
        "README.md"
    ],
    "scripts": {
        "build": "true",
        "cleanup:all": "pnpm run cleanup:artifacts && pnpm run cleanup:modules",
        "cleanup:artifacts": "true",
        "cleanup:modules": "rm -rf node_modules",
        "lint": "true",
        "test": "true",
        "test:docker": "./test/run.sh"
    },
    "engines": {
        "node": ">= 24",
        "pnpm": ">= 11.8"
    }
}
