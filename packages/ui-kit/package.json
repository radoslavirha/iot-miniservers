{
    "name": "@radoslavirha/ui-kit",
    "version": "0.2.0",
    "private": true,
    "description": "Shared design system and UI components for iot-miniservers UIs",
    "type": "module",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "default": "./src/index.ts"
        },
        "./styles.css": "./src/styles.css"
    },
    "files": [
        "src",
        "package.json"
    ],
    "scripts": {
        "build": "tsc --noEmit",
        "cleanup:all": "pnpm run cleanup:artifacts && pnpm run cleanup:modules",
        "cleanup:artifacts": "rm -rf coverage",
        "cleanup:modules": "rm -rf node_modules",
        "lint": "eslint .",
        "lint:fix": "eslint --fix .",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "peerDependencies": {
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
    },
    "devDependencies": {
        "@radoslavirha/config-eslint": "catalog:",
        "@radoslavirha/config-typescript": "catalog:",
        "@radoslavirha/config-vitest": "catalog:",
        "@testing-library/jest-dom": "catalog:react",
        "@testing-library/react": "catalog:react",
        "@types/react": "catalog:react",
        "@types/react-dom": "catalog:react",
        "@vitejs/plugin-react": "catalog:react",
        "@vitest/coverage-v8": "catalog:",
        "eslint": "catalog:",
        "jsdom": "catalog:react",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "typescript": "catalog:",
        "typescript-eslint": "catalog:",
        "vitest": "catalog:"
    },
    "engines": {
        "node": ">= 24",
        "pnpm": ">= 11.8"
    }
}
