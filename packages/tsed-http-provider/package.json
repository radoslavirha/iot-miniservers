{
    "name": "@radoslavirha/tsed-http-provider",
    "version": "0.2.1",
    "description": "Ts.ED wiring for @radoslavirha/http-provider: config-driven external API clients with request/response logging",
    "private": true,
    "type": "module",
    "exports": {
        "import": {
            "types": "./dist/esm/index.d.mts",
            "import": "./dist/esm/index.mjs"
        },
        "require": {
            "types": "./dist/cjs/index.d.cts",
            "require": "./dist/cjs/index.cjs"
        }
    },
    "main": "./dist/cjs/index.cjs",
    "module": "./dist/esm/index.mjs",
    "types": "./dist/esm/index.d.mts",
    "files": [
        "dist",
        "package.json",
        "README.md"
    ],
    "scripts": {
        "build": "tsc --noEmit && tsdown",
        "cleanup:all": "pnpm run cleanup:artifacts && pnpm run cleanup:modules",
        "cleanup:artifacts": "rm -rf coverage dist",
        "cleanup:modules": "rm -rf node_modules",
        "lint": "eslint .",
        "lint:fix": "eslint --fix .",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@radoslavirha/config-typescript": "catalog:",
        "@radoslavirha/http-provider": "workspace:*",
        "@radoslavirha/redaction": "catalog:",
        "@radoslavirha/resilience": "workspace:*",
        "@radoslavirha/utils": "catalog:",
        "typescript": "catalog:",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@radoslavirha/config-eslint": "catalog:",
        "@radoslavirha/config-tsdown": "catalog:",
        "@radoslavirha/config-vitest": "catalog:",
        "@radoslavirha/tsed-logger": "catalog:",
        "@swc/helpers": "catalog:swc",
        "@tsed/di": "catalog:tsed",
        "@tsed/exceptions": "catalog:tsed",
        "@tsed/platform-http": "catalog:tsed",
        "@tsed/schema": "catalog:tsed",
        "@types/node": "catalog:",
        "@vitest/coverage-v8": "catalog:",
        "axios": "catalog:",
        "axios-mock-adapter": "^2.1.0",
        "eslint": "catalog:",
        "tsdown": "catalog:",
        "tslib": "catalog:",
        "typescript-eslint": "catalog:",
        "vitest": "catalog:"
    },
    "peerDependencies": {
        "@radoslavirha/tsed-logger": "catalog:",
        "@tsed/di": "catalog:tsed",
        "@tsed/exceptions": "catalog:tsed",
        "axios": "catalog:"
    }
}
